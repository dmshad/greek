el":[],"roots":[],"forms":null,"ex":[{"ko":"Χαίρετε, κύριε Νίκο.","ru":"Здравствуйте, господин Никос."}],"extra":""},{"id":"a1-007","ko":"αντίο","tr":"анди́о","pr":null,"ru":"прощайте, до свидания","cat":"expr","sub":null,"tag":null,"block":2,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Αντίο, Μαρία!","ru":"Прощай, Мария!"}],"extra":"в речи чаще γεια σου / τα λέμε"},{"id":"a1-008","ko":"τα λέμε","tr":"та лэ́мэ","pr":null,"ru":"увидимся, до встречи","cat":"expr","sub":null,"tag":null,"block":2,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Τα λέμε αύριο!","ru":"Увидимся завтра!"}],"extra":"разг."},{"id":"a1-009","ko":"ευχαριστώ","tr":"эфхаристо́","pr":null,"ru":"спасибо","cat":"expr","sub":null,"tag":null,"block":2,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"— Ευχαριστώ! — Παρακαλώ.","ru":"— Спасибо! — Не за что."}],"extra":""},{"id":"a1-010","ko":"ευχαριστώ πολύ","tr":"эфхаристо́ поли́","pr":null,"ru":"большое спасибо","cat":"expr","sub":null,"tag":null,"block":2,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Ευχαριστώ πολύ, Νίκο!","ru":"Большое спасибо, Никос!"}],"extra":""},{"id":"a1-011","ko":"παρακαλώ","tr":"паракало́","pr":null,"ru":"пожалуйста; не за что; слушаю","cat":"expr","sub":null,"tag":null,"block":3,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Ένα νερό, παρακαλώ.","ru":"Воду, пожалуйста."},{"ko":"— Ευχαριστώ! — Παρακαλώ.","ru":"— Спасибо! — Не за что."}],"extra":""},{"id":"a1-012","ko":"συγγνώμη","tr":"сигно́ми","pr":null,"ru":"извините, простите","cat":"expr","sub":null,"tag":null,"block":3,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Συγγνώμη, πού είναι το μετρό;","ru":"Извините, где метро?"}],"extra":""},{"id":"a1-013","ko":"ναι","tr":"нэ","pr":null,"ru":"да","cat":"answer","sub":null,"tag":null,"block":3,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Ναι, ευχαριστώ.","ru":"Да, спасибо."}],"extra":""},{"id":"a1-014","ko":"όχι","tr":"о́хи","pr":null,"ru":"нет","cat":"answer","sub":null,"tag":null,"block":3,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Όχι, ευχαριστώ.","ru":"Нет, спасибо."}],"extra":""},{"id":"a1-015","ko":"εντάξει","tr":"энда́кси","pr":null,"ru":"хорошо, ладно, ок","cat":"answer","sub":null,"tag":null,"block":3,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"— Τα λέμε αύριο; — Εντάξει!","ru":"— Увидимся завтра? — Хорошо!"}],"extra":""},{"id":"a1-016","ko":"τι κάνεις;","tr":"ти ка́нис?","pr":null,"ru":"как дела? (на «ты»)","cat":"expr","sub":null,"tag":null,"block":4,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Γεια σου, Νίκο! Τι κάνεις;","ru":"Привет, Никос! Как дела?"}],"extra":"τι κάνετε; — на «вы»"},{"id":"a1-017","ko":"τι κάνετε;","tr":"ти ка́нэтэ?","pr":null,"ru":"как дела? (на «вы»)","cat":"expr","sub":null,"tag":null,"block":4,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Καλημέρα, κυρία Μαρία! Τι κάνετε;","ru":"Доброе утро, госпожа Мария! Как вы?"}],"extra":""},{"id":"a1-018","ko":"καλά","tr":"кала́","pr":null,"ru":"хорошо (наречие)","cat":"adv","sub":null,"tag":null,"block":4,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"— Τι κάνεις; — Καλά, ευχαριστώ.","ru":"— Как дела? — Хорошо, спасибо."}],"extra":""},{"id":"a1-019","ko":"τι γίνεται;","tr":"ти йи́нэтэ?","pr":null,"ru":"как дела?, что новенького?","cat":"expr","sub":null,"tag":null,"block":4,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"Γεια! Τι γίνεται;","ru":"Привет! Как жизнь?"}],"extra":"разг., очень частое"},{"id":"a1-020","ko":"έτσι κι έτσι","tr":"э́ци ки э́ци","pr":null,"ru":"так себе","cat":"expr","sub":null,"tag":null,"block":4,"weak":false,"usage":"","notes":[],"rel":[],"roots":[],"forms":null,"ex":[{"ko":"— Τι κάνεις; — Έτσι κι έτσι.","ru":"— Как дела? — Так себе."}],"extra":""}],"grammar":[{"id":"g1","n":1,"title":"Чтение 1: алфавит, звуки, ударение","meaning":"24 буквы, 7 гласных букв на 5 звуков. Большинство букв читается по одной; сочетания букв — в теме 3.\n**Ударение** пишется в каждом слове из двух и более слогов и считается частью написания: без него или на другом слоге — ошибка.\nУпражнения: слово дано ЗАГЛАВНЫМИ (как на вывеске) и с транскрипцией — напиши его строчными с ударением.","task_rk":"запиши строчными с ударением","nokr":true,"schema":[{"title":"Алфавит","cols":["Буква","Звук","Пример"],"rows":[["Α α · άλφα · [а́лфа]","а","Αθήνα [аθи́на]"],["Β β · βήτα · [ви́та]","в (не б!)","βιβλίο [вивли́о]"],["Γ γ · γάμμα · [га́ма]","г; перед э, и — й","γάλα [га́ла]"],["Δ δ · δέλτα · [δэ́лта]","δ (англ. this)","δέκα [δэ́ка]"],["Ε ε · έψιλον · [э́псилон]","э","έξι [э́кси]"],["Ζ ζ · ζήτα · [зи́та]","з","ζάχαρη [за́хари]"],["Η η · ήτα · [и́та]","и","νησί [ниси́]"],["Θ θ · θήτα · [θи́та]","θ (англ. think)","θεός [θэо́с]"],["Ι ι · γιώτα · [йо́та]","и","ψάρι [пса́ри]"],["Κ κ · κάπα · [ка́па]","к","κιλό [кило́]"],["Λ λ · λάμδα · [ла́мδа]","л","λάθος [ла́θос]"],["Μ μ · μι · [ми]","м","μάτι [ма́ти]"],["Ν ν · νι · [ни]","н (не в!)","νερό [нэро́]"],["Ξ ξ · ξι · [кси]","кс","ξένος [ксэ́нос]"],["Ο ο · όμικρον · [о́микрон]","о","όχι [о́хи]"],["Π π · πι · [пи]","п","πάρκο [па́рко]"],["Ρ ρ · ρο · [ро]","р (не п!)","Ρόδος [ро́δос]"],["Σ σ ς · σίγμα · [си́гма]","с; в конце — ς","φίλος [фи́лос]"],["Τ τ · ταυ · [таф]","т","ταξί [такси́]"],["Υ υ · ύψιλον · [и́псилон]","и","ρύζι [ри́зи]"],["Φ φ · φι · [фи]","ф","φως [фос]"],["Χ χ · χι · [хи]","х","χέρι [хэ́ри]"],["Ψ ψ · ψι · [пси]","пс","ψωμί [псоми́]"],["Ω ω · ωμέγα · [омэ́га]","о","ώρα [о́ра]"]],"note":"Обманчивые буквы: β = в, η = и, ν = н, ρ = р, υ = и, χ = х. Звук «и» пишется тремя буквами (η, ι, υ), «о» — двумя (ο, ω): какая буква — запоминается со словом."},{"title":"Где пишется ударение","cols":["Случай","Как пишется"],"rows":[["слово из 2+ слогов","всегда со знаком на ударной гласной · καφές · φίλος · θάλασσα"],["слово из 1 слога","без знака · ο · η · το · τι · φως"],["исключения","ή «или» (η — артикль) · πού «где» · πώς «как»"],["заглавная буква","знак слева сверху · Όλγα · Άννα · Έλενα"],["слово ЗАГЛАВНЫМИ","без ударений · ΤΑΞΙ · ΑΘΗΝΑ"]],"note":"Ударение различает слова: πότε «когда» — ποτέ «никогда». В приложении ответ без ударения или с ударением на другом слоге — ошибка."}],"sections":[{"id":"s1","title":"1. Гласные: 7 букв — 5 звуков","body":"α — а · ε — э · ο и ω — о · η, ι, υ — и. Долготы нет: ο и ω звучат одинаково.\nБезударные гласные не ослабляются: ο всегда «о», никакого «аканья». νερό — нэро́, не «нира́»; θάλασσα — θа́ласа.\nЗвук «э» в греческом не смягчает согласную: μέλι — мэ́ли.","ex":[{"ko":"νερό","ru":"нэро́ — вода"},{"ko":"μέλι","ru":"мэ́ли — мёд"},{"ko":"ρύζι","ru":"ри́зи — рис"}]},{"id":"s2","title":"2. Согласные: что читается не так, как выглядит","body":"**β** = в, **ρ** = р, **ν** = н, **χ** = х, **η** = и — похожи на латинские или русские буквы, но читаются иначе.\n**γ** — мягкое щелевое «г» (как южнорусское); перед звуками «э» и «и» — почти «й»: γάλα — га́ла, γέλιο — йэ́льо.\n**δ** — звонкий межзубный (англ. this), **θ** — глухой межзубный (англ. think). В транскрипции они так и пишутся: δ и θ.\n**ξ** = кс, **ψ** = пс, **ζ** = з.\nДвойные согласные читаются как одна: θάλασσα — θа́ласа, Ελλάδα — эла́δа.\n**σ** перед β, γ, δ, μ, ν, λ, ρ звучит как «з»: κόσμος — ко́змос.","ex":[{"ko":"βιβλίο","ru":"вивли́о — книга"},{"ko":"χέρι","ru":"хэ́ри — рука"},{"ko":"δέκα","ru":"δэ́ка — десять"},{"ko":"θέατρο","ru":"θэ́атро — театр"}]},{"id":"s3","title":"3. Ударение (τόνος)","body":"В каждом слове из двух и более слогов над ударной гласной стоит знак: καφές, φίλος, τηλέφωνο. Ударение бывает только на одном из трёх последних слогов.\nСлова из одного слога пишутся без знака: ο, η, το, τι, φως, γεια, μια.\nИсключения различают пары слов: **ή** «или» — η (артикль); **πού** «где» — που «который»; **πώς** «как» — πως «что».\nНа заглавной букве знак стоит слева сверху: Όλγα, Άννα. Слова, написанные целиком заглавными (вывески, заголовки), пишутся без ударений: ΤΑΞΙ.","ex":[{"ko":"νερό ή γάλα;","ru":"нэро́ и га́ла? — вода или молоко?"},{"ko":"το ταξί","ru":"то такси́ — такси"}]},{"id":"s4","title":"4. Конечная ς","body":"Буква σ в конце слова пишется как **ς**: φίλος, καφές, Νάξος. В начале и в середине — σ: σαλάτα, θάλασσα.\nНа iPhone клавиша сигмы одна: в конце слова клавиатура сама ставит ς. В приложении σ в конце слова ошибкой не считается.","ex":[{"ko":"ο φίλος","ru":"о фи́лос — друг"},{"ko":"ο καφές","ru":"о кафэ́с — кофе"}]},{"id":"s5","title":"5. Клавиатура iPhone","body":"Добавить: Настройки → Основные → Клавиатура → Клавиатуры → Новые клавиатуры → Греческая. Переключение — кнопкой 🌐.\n**Ударение** — клавиша «΄» в верхнем ряду справа. Нажимается **после** гласной: α, затем «΄» → ά.\n**ς** отдельно набирать не нужно: клавиша Σ одна, в конце слова буква меняется сама.\nВопросительный знак в греческом выглядит как «;»: Τι κάνεις; В ответах приложения знаки препинания не проверяются.","ex":[]}],"usage":[{"id":"u1","sit":"Прочитать слово по буквам","phrase":"ταξί","note":"та-кси́: каждая буква — свой звук, знак показывает ударный слог.","ex":[{"ko":"σαλάτα","ru":"сала́та — салат"}]},{"id":"u2","sit":"Вывеска заглавными","phrase":"ΘΑΛΑΣΣΑ → θάλασσα","note":"Заглавными — без ударений; строчными — ударение обязательно.","ex":[]},{"id":"u3","sit":"Поставить ударение","phrase":"καφές","note":"Знак — над ударной гласной; в односложных словах — нет.","ex":[{"ko":"φως","ru":"фос — свет"}]},{"id":"u4","sit":"Конечная ς","phrase":"ο φίλος","note":"σ в конце слова пишется как ς.","ex":[]}],"rel":[],"new":[],"parts":[{"id":"q1","title":"Буквы и звуки","intro":"Как читается каждая буква. Главное — запомнить обманчивые буквы: β = в, η = и, ν = н, ρ = р, χ = х.","schema":[0],"sections":["s1","s2"],"usage":["u1","u2"],"ex":[[{"ru":"ΤΑΞΙ — такси́ (такси)","ko":"ταξί","alt":[],"u":"u1","traps":[]},{"ru":"ΜΕΤΡΟ — мэтро́ (метро)","ko":"μετρό","alt":[],"u":"u1","traps":[]},{"ru":"ΑΘΗΝΑ — аθи́на (Афины)","ko":"Αθήνα","alt":[],"u":"u1","traps":[]},{"ru":"ΣΙΝΕΜΑ — синэма́ (кино)","ko":"σινεμά","alt":[],"u":"u1","traps":[]},{"ru":"ΚΙΛΟ — кило́ (килограмм)","ko":"κιλό","alt":[],"u":"u1","traps":[]}],[{"ru":"ΛΕΜΟΝΙ — лэмо́ни (лимон)","ko":"λεμόνι","alt":[],"u":"u2","traps":[]},{"ru":"ΣΑΛΑΤΑ — сала́та (салат)","ko":"σαλάτα","alt":[],"u":"u2","traps":[]},{"ru":"ΠΑΤΑΤΑ — пата́та (картофель)","ko":"πατάτα","alt":[],"u":"u2","traps":[]},{"ru":"ΡΥΖΙ — ри́зи (рис)","ko":"ρύζι","alt":[],"u":"u2","traps":[]},{"ru":"ΤΥΡΙ — тири́ (сыр)","ko":"τυρί","alt":[],"u":"u2","traps":[]}],[{"ru":"ΓΑΛΑ — га́ла (молоко)","ko":"γάλα","alt":[],"u":"u1","traps":[]},{"ru":"ΨΑΡΙ — пса́ри (рыба)","ko":"ψάρι","alt":[],"u":"u1","traps":[]},{"ru":"ΞΕΝΟΣ — ксэ́нос (иностранец)","ko":"ξένος","alt":[],"u":"u2","traps":[]},{"ru":"ΖΑΧΑΡΗ — за́хари (сахар)","ko":"ζάχαρη","alt":[],"u":"u2","traps":[]},{"ru":"ΘΑΛΑΣΣΑ — θа́ласа (море)","ko":"θάλασσα","alt":[],"u":"u2","traps":[]}]]},{"id":"q2","title":"Ударение, ς и клавиатура","intro":"Ударение пишется в каждом слове из двух и более слогов; ς — в конце слова. На iPhone ударение — клавиша «΄» после гласной.","schema":[1],"sections":["s3","s4","s5"],"usage":["u3","u4"],"ex":[[{"ru":"ΚΑΦΕΣ — кафэ́с (кофе)","ko":"καφές","alt":[],"u":"u3","traps":[]},{"ru":"Ο ΦΙΛΟΣ — о фи́лос (друг)","ko":"ο φίλος","alt":[],"u":"u4","traps":[]},{"ru":"ΤΗΛΕΦΩΝΟ — тилэ́фоно (телефон)","ko":"τηλέφωνο","alt":[],"u":"u3","traps":[]},{"ru":"ΘΕΑΤΡΟ — θэ́атро (театр)","ko":"θέατρο","alt":[],"u":"u3","traps":[]},{"ru":"ΕΛΛΑΔΑ — эла́δа (Греция)","ko":"Ελλάδα","alt":[],"u":"u3","traps":[]}],[{"ru":"ΟΛΓΑ — о́лга (Ольга)","ko":"Όλγα","alt":[],"u":"u3","traps":[]},{"ru":"Η ΚΡΗΤΗ — и кри́ти (Крит)","ko":"η Κρήτη","alt":[],"u":"u3","traps":[]},{"ru":"ΤΟ ΝΕΡΟ — то нэро́ (вода)","ko":"το νερό","alt":[],"u":"u3","traps":[]},{"ru":"ΝΕΡΟ Η ΓΑΛΑ — нэро́ и́ га́ла (вода или молоко)","ko":"νερό ή γάλα","alt":[],"u":"u3","traps":[]},{"ru":"ΟΧΙ — о́хи (нет)","ko":"όχι","alt":[],"u":"u3","traps":[]}],[{"ru":"ΦΩΣ — фос (свет)","ko":"φως","alt":[],"u":"u3","traps":[]},{"ru":"ΨΑΡΙ Η ΚΡΕΑΣ — пса́ри и́ крэ́ас (рыба или мясо)","ko":"ψάρι ή κρέας","alt":[],"u":"u3","traps":[]},{"ru":"ΔΩΔΕΚΑ — δо́δэка (двенадцать)","ko":"δώδεκα","alt":[],"u":"u3","traps":[]},{"ru":"ΝΑΞΟΣ — на́ксос (Наксос)","ko":"Νάξος","alt":[],"u":"u4","traps":[]},{"ru":"ΕΞΙ — э́кси (шесть)","ko":"έξι","alt":[],"u":"u3","traps":[]}]]}]},{"id":"g3","n":3,"title":"Чтение 2: сочетания букв","meaning":"Две буквы — один звук: ου = у, αι = э, ει / οι = и; μπ = б, ντ = д, τσ = ц. Перед гласной γ звучит как «й», а безударное ι почти сливается со следующей гласной.\nУпражнения — как в теме 1, на словах и выражениях темы «Приветствия» и новых словах.","task_rk":"запиши строчными с ударением","nokr":true,"schema":[{"title":"Сочетания гласных","cols":["Буквы","Звук","Пример"],"rows":[["ου","у","σούπα [су́па] · μουσική [мусики́]"],["αι","э","και [кэ] · χαίρετε [хэ́рэтэ]"],["ει · οι · υι","и","είκοσι [и́коси] · τοίχος [ти́хос]"],["αυ · ευ","ав · эв — перед гласной и звонкой","αυγό [авго́] · Ευρώπη [эвро́пи]"],["αυ · ευ","аф · эф — перед θ κ ξ π σ τ φ χ ψ","αυτός [афто́с] · ευχαριστώ [эфхаристо́]"]],"note":"Ударение на сочетании ставится над второй буквой: είκοσι, σούπα, ευχαριστώ. Односложные слова (και, ναι) — по общему правилу без знака."},{"title":"Сочетания согласных","cols":["Буквы","В начале слова","В середине слова"],"rows":[["μπ","б · μπίρα [би́ра]","мб · λάμπα [ла́мба]"],["ντ","д · ντομάτα [дома́та]","нд · πέντε [пэ́ндэ]"],["γκ","г · γκρι [гри]","нг"],["γγ","—","нг · Αγγλία [англи́а]"],["τσ","ц · τσάι [ца́и]","ц · έτσι [э́ци]"],["τζ","дз · τζάμι [дза́ми]","дз"]],"note":"В живой речи μπ, ντ, γκ в середине слова часто звучат просто как б, д, г. Исключение темы: συγγνώμη — сигно́ми."},{"title":"γ и ι перед гласной","cols":["Сочетание","Звук","Пример"],"rows":[["γ + ε, αι, ι, η, υ, ει, οι","й","γυναίκα [йинэ́ка] · τι γίνεται; [ти йи́нэтэ?]"],["γι, γει + гласная","й + гласная","γεια σου [йа су] · γιαγιά [йайа́]"],["согласная + безударное ι + гласная","ь + гласная: ья, ьо, ью","παιδιά [пэδья́] · πιάτο [пья́то] · ήλιος [и́льос]"]],"note":"Звук «й» после γ и мягкий призвук после других согласных — это один слог: γεια — один слог, παιδιά — два."}],"sections":[{"id":"s1","title":"1. Две гласные — один звук","body":"**ου** = у: σούπα — су́па, πού — пу.\n**αι** = э: και — кэ, χαίρετε — хэ́рэтэ.\n**ει, οι, υι** = и: είκοσι — и́коси, τοίχος — ти́хос.\nУдарение в таком сочетании ставится над второй буквой: είκοσι, σούπα, ευχαριστώ.","ex":[{"ko":"καλημέρα","ru":"калимэ́ра — доброе утро"},{"ko":"χαίρετε","ru":"хэ́рэтэ — здравствуйте"},{"ko":"τι κάνεις;","ru":"ти ка́нис? — как дела?"}]},{"id":"s2","title":"2. αυ и ευ","body":"υ после α и ε звучит как согласная: «в» перед гласной и звонкой согласной, «ф» перед глухой (θ, κ, ξ, π, σ, τ, φ, χ, ψ).\nαυγό — авго́, Ευρώπη — эвро́пи; αυτός — афто́с, ευχαριστώ — эфхаристо́.","ex":[{"ko":"ευχαριστώ","ru":"эфхаристо́ — спасибо"},{"ko":"αύριο","ru":"а́врио — завтра"}]},{"id":"s3","title":"3. Когда буквы читаются раздельно","body":"Если ударение стоит на первой букве пары или над второй стоят две точки (ϊ, ϋ), буквы читаются отдельно: τσάι — ца́и, ρολόι — роло́и, λαϊκή — лаики́.\nТакие слова в курсе редкие — набирать точки почти не придётся.","ex":[{"ko":"τσάι","ru":"ца́и — чай"},{"ko":"λαϊκή","ru":"лаики́ — уличный рынок"}]},{"id":"s4","title":"4. Две согласные — один звук","body":"**μπ** — б в начале слова, мб в середине: μπίρα — би́ра, λάμπα — ла́мба.\n**ντ** — д / нд: ντομάτα — дома́та, πέντε — пэ́ндэ.\n**γκ** — г / нг: γκρι — гри. **γγ** — нг: Αγγλία — англи́а.\n**τσ** — ц: τσάι, έτσι. **τζ** — дз: τζάμι.\nИсключение: συγγνώμη «извините» читается сигно́ми.","ex":[{"ko":"εντάξει","ru":"энда́кси — хорошо, ладно"},{"ko":"έτσι κι έτσι","ru":"э́ци ки э́ци — так себе"},{"ko":"συγγνώμη","ru":"сигно́ми — извините"}]},{"id":"s5","title":"5. γ перед «э» и «и» — «й»","body":"Перед ε, αι, ι, η, υ, ει, οι буква γ звучит как «й»: γυναίκα — йинэ́ка, γίνεται — йи́нэтэ.\nВ γι, γει + гласная буква ι не читается отдельно: γεια — йа (один слог), γιαγιά — йайа́.","ex":[{"ko":"γεια σου","ru":"йа су — привет"},{"ko":"τι γίνεται;","ru":"ти йи́нэтэ? — как жизнь?"}]},{"id":"s6","title":"6. Безударное ι перед гласной","body":"После согласной безударное ι (а также ει, οι, υ) перед гласной не образует слога — получается мягкий призвук: παιδιά — пэδья́, πιάτο — пья́то, ήλιος — и́льос.\nВ некоторых книжных словах ι звучит полностью: δωμάτιο — δома́тио; в словаре такие слова отмечены транскрипцией.\n**σ** перед звонкими (β, γ, δ, μ, ν, λ, ρ) звучит как «з»: κόσμος — ко́змос.","ex":[{"ko":"παιδιά","ru":"пэδья́ — дети"},{"ko":"καρδιά","ru":"карδья́ — сердце"}]}],"usage":[{"id":"u1","sit":"Сочетание гласных","phrase":"καλημέρα · ευχαριστώ","note":"ου, αι, ει, οι — один звук; αυ, ευ — ав/аф, эв/эф.","ex":[]},{"id":"u2","sit":"Сочетание согласных","phrase":"εντάξει · έτσι","note":"μπ, ντ, γκ, τσ, τζ — один звук.","ex":[]},{"id":"u3","sit":"γ и ι перед гласной","phrase":"γεια σου · παιδιά","note":"γ → й; безударное ι — мягкий призвук.","ex":[]}],"rel":[{"id":"g1"}],"new":[],"parts":[{"id":"q1","title":"Сочетания гласных","intro":"ου = у, αι = э, ει / οι = и; αυ, ευ — ав/аф, эв/эф. Ударение — над второй буквой пары.","schema":[0],"sections":["s1","s2","s3"],"usage":["u1"],"ex":[[{"ru":"ΚΑΛΗΜΕΡΑ — калимэ́ра (доброе утро)","ko":"καλημέρα","alt":[],"u":"u1","traps":[]},{"ru":"ΚΑΛΗΣΠΕΡΑ — калиспэ́ра (добрый вечер)","ko":"καλησπέρα","alt":[],"u":"u1","traps":[]},{"ru":"ΚΑΛΗΝΥΧΤΑ — калини́хта (спокойной ночи)","ko":"καληνύχτα","alt":[],"u":"u1","traps":[]},{"ru":"ΧΑΙΡΕΤΕ — хэ́рэтэ (здравствуйте)","ko":"χαίρετε","alt":[],"u":"u1","traps":[]},{"ru":"ΕΥΧΑΡΙΣΤΩ — эфхаристо́ (спасибо)","ko":"ευχαριστώ","alt":[],"u":"u1","traps":[]}],[{"ru":"ΠΑΡΑΚΑΛΩ — паракало́ (пожалуйста)","ko":"παρακαλώ","alt":[],"u":"u1","traps":[]},{"ru":"ΝΑΙ — нэ (да)","ko":"ναι","alt":[],"u":"u1","traps":[]},{"ru":"ΤΙ ΚΑΝΕΙΣ; — ти ка́нис? (как дела?, на «ты»)","ko":"τι κάνεις;","alt":[],"u":"u1","traps":[]},{"ru":"ΤΙ ΚΑΝΕΤΕ; — ти ка́нэтэ? (как дела?, на «вы»)","ko":"τι κάνετε;","alt":[],"u":"u1","traps":[]},{"ru":"ΤΑ ΛΕΜΕ — та лэ́мэ (увидимся)","ko":"τα λέμε","alt":[],"u":"u1","traps":[]}],[{"ru":"ΣΟΥΠΑ — су́па (суп)","ko":"σούπα","alt":[],"u":"u1","traps":[]},{"ru":"ΕΙΚΟΣΙ — и́коси (двадцать)","ko":"είκοσι","alt":[],"u":"u1","traps":[]},{"ru":"ΑΥΓΟ — авго́ (яйцо)","ko":"αυγό","alt":[],"u":"u1","traps":[]},{"ru":"ΑΥΤΟΣ — афто́с (он)","ko":"αυτός","alt":[],"u":"u1","traps":[]},{"ru":"ΤΣΑΙ — ца́и (чай)","ko":"τσάι","alt":[],"u":"u1","traps":[]}]]},{"id":"q2","title":"Сочетания согласных","intro":"μπ = б (мб), ντ = д (нд), γκ = г (нг), τσ = ц, τζ = дз.","schema":[1],"sections":["s4"],"usage":["u2"],"ex":[[{"ru":"ΕΝΤΑΞΕΙ — энда́кси (хорошо, ладно)","ko":"εντάξει","alt":[],"u":"u2","traps":[]},{"ru":"ΑΝΤΙΟ — анди́о (до свидания)","ko":"αντίο","alt":[],"u":"u2","traps":[]},{"ru":"ΕΤΣΙ ΚΙ ΕΤΣΙ — э́ци ки э́ци (так себе)","ko":"έτσι κι έτσι","alt":[],"u":"u2","traps":[]},{"ru":"ΣΥΓΓΝΩΜΗ — сигно́ми (извините)","ko":"συγγνώμη","alt":[],"u":"u2","traps":[]},{"ru":"ΜΠΙΡΑ — би́ра (пиво)","ko":"μπίρα","alt":[],"u":"u2","traps":[]}],[{"ru":"ΛΑΜΠΑ — ла́мба (лампа)","ko":"λάμπα","alt":[],"u":"u2","traps":[]},{"ru":"ΝΤΟΜΑΤΑ — дома́та (помидор)","ko":"ντομάτα","alt":[],"u":"u2","traps":[]},{"ru":"ΠΕΝΤΕ — пэ́ндэ (пять)","ko":"πέντε","alt":[],"u":"u2","traps":[]},{"ru":"ΚΕΝΤΡΟ — кэ́ндро (центр)","ko":"κέντρο","alt":[],"u":"u2","traps":[]},{"ru":"ΑΓΓΛΙΑ — англи́а (Англия)","ko":"Αγγλία","alt":[],"u":"u2","traps":[]}]]},{"id":"q3","title":"γ и ι перед гласной","intro":"γ перед «э» и «и» — «й»; безударное ι перед гласной — мягкий призвук, а не отдельный слог.","schema":[2],"sections":["s5","s6"],"usage":["u3"],"ex":[[{"ru":"ΓΕΙΑ ΣΟΥ — йа су (привет, на «ты»)","ko":"γεια σου","alt":[],"u":"u3",